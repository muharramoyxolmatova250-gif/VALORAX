# Copy to .env and fill these values locally. NEVER commit .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_LOCALLY
SEARXNG_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Start conservatively on a small Always Free VM.
SEARCH_CONCURRENCY=2
SEARCH_PAGES_PER_QUERY=2
WORKER_CONCURRENCY=2
OMNISIGHT_TARGET_DAILY_RAW=10000
OMNISIGHT_TARGET_DAILY_CANDIDATES=10000
